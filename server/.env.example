PORT=3001
DB_PATH=./data/ss-budget.sqlite
# OBLIGATOIRE. Protège l'API (x-ss-budget-secret) ET signe les jetons de connexion PIN.
# Le serveur REFUSE DE DÉMARRER si APP_SECRET est absent, fait moins de 32 caractères,
# contient moins de 10 caractères distincts, est entouré d'espaces ou reprend une
# valeur publique/d'exemple (comme celle ci-dessous). Générer une valeur aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changer APP_SECRET invalide immédiatement toutes les sessions ; saisir ensuite le
# nouveau secret dans « Modifier la configuration du serveur » sur chaque téléphone.
APP_SECRET=change-moi-avec-une-phrase-longue
CORS_ORIGIN=*

# Options V2.8 (authentification par PIN), toutes facultatives :
# Nombre d'essais de PIN avant verrouillage temporaire du profil (défaut 5).
# PIN_MAX_ATTEMPTS=5
# Durée du verrouillage temporaire en minutes (défaut 15).
# PIN_LOCK_MINUTES=15
# Durée de validité d'un jeton de connexion en heures (défaut 12).
# AUTH_TOKEN_TTL_HOURS=12
