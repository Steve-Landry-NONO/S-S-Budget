PORT=3001
DB_PATH=./data/ss-budget.sqlite
# Protège l'API (x-ss-budget-secret) ET sert de clé de signature pour les jetons de
# connexion PIN depuis la V2.8 (voir PATCH_V2_8_AUTH_PROFILS.md). Change impérativement
# cette valeur avant tout usage réel : si elle reste sur l'exemple ci-dessous, le serveur
# retombe sur une clé de développement non sécurisée pour signer les jetons.
APP_SECRET=change-moi-avec-une-phrase-longue
CORS_ORIGIN=*

# Options V2.8 (authentification par PIN), toutes facultatives :
# Nombre d'essais de PIN avant verrouillage temporaire du profil (défaut 5).
# PIN_MAX_ATTEMPTS=5
# Durée du verrouillage temporaire en minutes (défaut 15).
# PIN_LOCK_MINUTES=15
# Durée de validité d'un jeton de connexion en heures (défaut 12).
# AUTH_TOKEN_TTL_HOURS=12
